{
  "name": "rebask-cloudflare-adapter",
  "version": "0.5.0",
  "description": "Community Rebask adapter for Cloudflare Workers: SSR, RSC, PPR, durable ISR, CDN pages, signed Draft Mode and image optimization.",
  "type": "module",
  "license": "MIT",
  "author": "hipdev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hipdev/rebask-cloudflare-adapter.git"
  },
  "homepage": "https://github.com/hipdev/rebask-cloudflare-adapter#readme",
  "bugs": {
    "url": "https://github.com/hipdev/rebask-cloudflare-adapter/issues"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js"
    },
    "./cache": {
      "types": "./dist/cache.d.ts",
      "import": "./dist/cache.js"
    },
    "./storage": {
      "types": "./dist/storage.d.ts",
      "import": "./dist/storage.js"
    },
    "./package.json": "./package.json",
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    },
    "./durable-object": {
      "types": "./dist/durable-object.d.ts",
      "import": "./dist/durable-object.js"
    },
    "./draft": {
      "types": "./dist/draft.d.ts",
      "import": "./dist/draft.js"
    },
    "./edge": {
      "types": "./dist/edge.d.ts",
      "import": "./dist/edge.js"
    },
    "./images": {
      "types": "./dist/images.d.ts",
      "import": "./dist/images.js"
    },
    "./workers-cache": {
      "types": "./dist/workers-cache.d.ts",
      "import": "./dist/workers-cache.js"
    },
    "./purge-object": {
      "types": "./dist/purge-object.d.ts",
      "import": "./dist/purge-object.js"
    },
    "./telemetry": {
      "types": "./dist/telemetry.d.ts",
      "import": "./dist/telemetry.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "AGENTS.md",
    "llms.txt",
    "CHANGELOG.md",
    "README.es.md",
    "CONTRIBUTING.md"
  ],
  "sideEffects": false,
  "keywords": [
    "rebask",
    "cloudflare",
    "workers",
    "ppr",
    "react",
    "server-components",
    "vite"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:integration": "node scripts/integration.mjs && node scripts/test-workers-cache-local.mjs",
    "prepack": "npm run build",
    "test:remote": "node scripts/remote-ci.mjs"
  },
  "dependencies": {
    "jsonc-parser": "3.3.1"
  },
  "peerDependencies": {
    "@rebask/core": "0.2.0",
    "vite": "8.3.5"
  },
  "devDependencies": {
    "@rebask/core": "0.2.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-rsc": "0.5.38",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "wrangler": "4.156.0",
    "@cloudflare/workers-types": "5.20261101.1"
  }
}
